{
  "name": "@blygger/studio",
  "version": "0.74.0",
  "private": true,
  "description": "Blygger Studio — reference client for the Blygger protocol (publish, subscribe, thread, transclude, respond)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blygger/blygger-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "init": "node --experimental-strip-types scripts/init.ts",
    "upgrade": "node --experimental-strip-types scripts/upgrade.ts",
    "test": "vitest run",
    "patches": "node --import tsx scripts/patches.ts",
    "export": "node --experimental-strip-types scripts/export.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "deploy": "wrangler deploy",
    "deploy:all": "node --experimental-strip-types scripts/deploy-all.ts",
    "deploy:vgr": "wrangler deploy --config wrangler.private.jsonc --env venkateshrao",
    "deploy:pi": "wrangler deploy --config wrangler.private.jsonc --env protocolInstitute",
    "openapi": "node --import tsx scripts/openapi.ts",
    "sdk:generate": "npm run openapi && node --import tsx scripts/generate-sdk.ts && npm run build",
    "build": "node --import tsx scripts/build-extensions.ts && node --import tsx scripts/build-patches.ts && node --import tsx scripts/build-models.ts && node --import tsx scripts/build-sdk.ts && node --import tsx scripts/build-spa.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.ui.json && node node_modules/typescript/bin/tsc -p tsconfig.oracles.json",
    "test:e2e": "playwright test",
    "test:oauth:interop": "node --import tsx scripts/verify-oauth-interop.ts",
    "test:oauth:conformance": "node --import tsx scripts/verify-oidc-conformance.ts",
    "test:upgrade": "node --import tsx scripts/verify-upgrade.ts",
    "check:template": "node --import tsx scripts/check-template.ts",
    "check:fixtures": "node --import tsx scripts/check-feed-fixtures.ts",
    "ext:add": "node --import tsx scripts/ext-vendor.ts add",
    "ext:update": "node --import tsx scripts/ext-vendor.ts update",
    "ext:remove": "node --import tsx scripts/ext-vendor.ts remove",
    "predev": "npm run build",
    "predeploy": "npm run build",
    "pretest": "npm run build",
    "predeploy:all": "npm run build",
    "predeploy:vgr": "npm run build",
    "predeploy:pi": "npm run build",
    "release:build": "npm run build && node --import tsx scripts/release.ts",
    "release:verify": "node --import tsx scripts/verify-release.ts",
    "release:check": "node --import tsx scripts/check-release.ts",
    "postinstall": "npm run build",
    "test:polling-cache:mutations": "node --import tsx scripts/verify-polling-cache-mutations.ts",
    "test:mutations": "node --import tsx scripts/verify-oracle-mutations.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:auth:security": "npm run test:oracles:gaps -- --runtime worker --files test/auth-security.oracle.test.ts --source src/oauth.ts --sample 1 && node --import tsx scripts/verify-auth-security-race.ts",
    "test:auth:security:mutations": "node --import tsx scripts/verify-auth-security-mutations.ts",
    "test:oracles:search": "node --import tsx scripts/run-oracle-gaps.ts --runtime worker --files test/search-index.oracle.test.ts --source src/search-terms.ts && node --import tsx scripts/run-oracle-gaps.ts --runtime worker --files test/search-index.oracle.test.ts --source src/read-api.ts,src/backup-format.ts,src/cursor-page.ts --mutants test/fixtures/search-index-mutants --only authored:search-working-copy-uses-publication,authored:search-subscription-filter-after-fts,authored:search-drops-short-term-filter,authored:search-repeats-fts-per-cursor-range,authored:backup-copies-derived-search-documents,authored:review-repeated-search-query",
    "test:oracles:worker": "npm run test:oracles:gaps -- --runtime worker --source src/oauth-storage.ts --sample 1",
    "test:oracles:studio": "npm run test:oracles:gaps -- --runtime studio",
    "test:oracles:browser": "node --import tsx scripts/run-browser-oracle-gaps.ts",
    "test:oracles:browser:search": "node --import tsx scripts/run-search-oracle-gaps.ts",
    "test:oracles:browser:publish": "node --import tsx scripts/run-publish-oracle-gaps.ts",
    "test:oracles:formatting": "npm run test:formatting -- --baseline-only --contexts 2",
    "test:oracles": "npm run test:oracles:worker && npm run test:oracles:studio && npm run test:oracles:browser && npm run test:oracles:browser:search && npm run test:oracles:browser:publish && npm run test:oracles:formatting",
    "test:oracles:runtime": "node --import tsx scripts/verify-worker-oracle-runtime.ts",
    "test:oracles:browser:mutations": "node --import tsx scripts/verify-save-oracle-mutations.ts",
    "check:oracle-migration": "node --import tsx scripts/check-oracle-migration.ts",
    "lint:oracles": "eslint . --max-warnings=0",
    "test:oracles:gaps": "node --import tsx scripts/run-oracle-gaps.ts",
    "test:oracles:contracts": "npm run test:oracles:gaps -- --runtime worker --files test/oauth-storage.oracle.test.ts,test/mention-order.oracle.test.ts,test/api-mount-cutover.oracle.test.ts --source src/oauth-storage.ts,src/mention-groups.ts,src/oauth.ts --only oauth-storage.ts:M51,mention-groups.ts:M12,oauth.ts:M1",
    "test:oracles:conditional:worker": "npm run test:oracles:gaps -- --runtime worker --files test/derived-validators.oracle.test.ts --source src/conditional-operation.ts --mutants test-oracles/mutants --only authored:unsafe-getItem-counter-shortcut,authored:unsafe-listItemVersions-counter-shortcut,authored:unsafe-listReading-counter-shortcut,authored:unsafe-getReadingSummary-counter-shortcut && npm run test:oracles:conditional:handoff --",
    "test:oracles:conditional:handoff": "npm run test:oracles:gaps -- --runtime worker --files test/batch-validator-work.oracle.test.ts,test/cursor-validator-handoff.oracle.test.ts,test/cursor-keyset.oracle.test.ts,test/cursor-indexed-work.oracle.test.ts --source src/conditional-operation.ts,src/cursor-page.ts --mutants test/fixtures/conditional-handoff-mutants --only authored:detached-generation-handoff,authored:ignored-completed-generation,authored:cursor-reuses-first-snapshot-on-retry,authored:cursor-trusts-initial-as-complete,authored:cursor-completes-failed-projection,authored:stamp-crosses-full-generation-change,authored:keyset-retains-descending-null-tail,authored:keyset-inverts-null-direction,authored:keyset-unions-prefix-equality,authored:cursor-five-ranges-scan",
    "test:formatting": "node --import tsx scripts/formatting-oracles.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/oauth-provider": "1.7.28",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/db": "1.0.0-rc.1.6",
    "@tanstack/query-core": "^5.108.4",
    "@tanstack/query-db-collection": "^1.5.3",
    "@tanstack/react-db": "1.0.0-rc.1.6",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "1.7.28",
    "dataloader": "2.2.3",
    "entities": "9.0.0",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.23",
    "ipaddr.js": "2.5.0",
    "markdown-it": "^14.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "temml": "0.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.10.0",
    "@cloudflare/workers-types": "^5",
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/eslint-plugin-oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/eslint-plugin-oracles@97a4e7a",
    "@tanstack/oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/oracles@97a4e7a",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/expect": "4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.11.0",
    "jose": "6.2.18",
    "miniflare": "5.20261127.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.169.0"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
