{
  "name": "@blygger/studio",
  "version": "0.49.9",
  "private": true,
  "description": "Blygger Studio \u2014 reference client for the Blygger protocol (publish, subscribe, thread, transclude, respond)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blygger/blygger-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "init": "node --experimental-strip-types scripts/init.ts",
    "upgrade": "node --experimental-strip-types scripts/upgrade.ts",
    "test": "vitest run",
    "export": "node --experimental-strip-types scripts/export.ts",
    "deploy": "wrangler deploy",
    "deploy:all": "node --experimental-strip-types scripts/deploy-all.ts",
    "deploy:vgr": "wrangler deploy --config wrangler.private.jsonc --env venkateshrao",
    "deploy:pi": "wrangler deploy --config wrangler.private.jsonc --env protocolInstitute",
    "openapi": "node --import tsx scripts/openapi.ts",
    "sdk:generate": "npm run openapi && node --import tsx scripts/generate-sdk.ts && npm run build",
    "build": "node --import tsx scripts/build-extensions.ts && node --import tsx scripts/build-models.ts && node --import tsx scripts/build-sdk.ts && node --import tsx scripts/build-spa.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test:e2e": "playwright test",
    "test:oauth:interop": "node --import tsx scripts/verify-oauth-interop.ts",
    "test:oauth:conformance": "node --import tsx scripts/verify-oidc-conformance.ts",
    "test:upgrade": "node --import tsx scripts/verify-upgrade.ts",
    "check:template": "node --import tsx scripts/check-template.ts",
    "predev": "npm run build",
    "predeploy": "npm run build",
    "pretest": "npm run build",
    "predeploy:all": "npm run build",
    "predeploy:vgr": "npm run build",
    "predeploy:pi": "npm run build",
    "release:build": "npm run build && node --import tsx scripts/release.ts",
    "release:verify": "node --import tsx scripts/verify-release.ts",
    "release:check": "node --import tsx scripts/check-release.ts",
    "postinstall": "npm run build",
    "test:polling-cache:mutations": "node --import tsx scripts/verify-polling-cache-mutations.ts",
    "test:mutations": "node --import tsx scripts/verify-oracle-mutations.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:auth:security": "vitest run test/auth-security.oracle.test.ts && node --import tsx scripts/verify-auth-security-race.ts",
    "test:auth:security:mutations": "node --import tsx scripts/verify-auth-security-mutations.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/oauth-provider": "1.7.14",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/db": "1.0.0-rc.1",
    "@tanstack/query-core": "^5.105.0",
    "@tanstack/query-db-collection": "^1.5.0",
    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "1.7.14",
    "entities": "4.5.0",
    "fast-xml-parser": "^5",
    "hono": "^4",
    "ipaddr.js": "2.5.0",
    "markdown-it": "^14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5",
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jose": "6.2.14",
    "miniflare": "5.20261023.3-beta",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
