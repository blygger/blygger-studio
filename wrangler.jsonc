{
  // ── Blygger Studio — deployment config ───────────────────────────────────
  //
  // This file is GENERIC on purpose. It describes a blyg, not anyone's blyg.
  // `npm run init` fills in the four values marked FILL ME below; if you are
  // doing it by hand, they are the only four you need.
  //
  // Nothing here names a Cloudflare account, a database, a domain or a route,
  // so a copy of this repo carries no dependency on — and no detail of — the
  // deployment it was copied from. That is deliberate, and it is a constraint
  // on us as much as on you: see "Keep this file generic" at the bottom.
  //
  // Everything deployment-specific lives in exactly two files, this one and
  // `deploy-targets.json`. Nothing under `src/` should ever need editing to
  // configure an instance — if it does, that is a bug in the client, because
  // it would break your upgrade path. Report it.

  "name": "blyg",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Only public HTML uses the shared 60-second cache. The router stays uncached.
  "cache": { "enabled": false },
  "exports": {
    "PublicHtml": { "type": "worker", "cache": { "enabled": true } }
  },
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Where the public surface is mounted (decision #14).
    //   ""       → domain root, e.g. https://blyg.you.com/          ← recommended
    //   "/blyg"  → a path, e.g. https://you.com/blyg/
    //
    // A subdomain with MOUNT "" is the recommended shape and the only one
    // `npm run init` provisions. A path mount works and is fully supported by
    // the protocol, but `/studio` and `/api` are host-rooted regardless of
    // MOUNT, so a path mount on a domain already serving `/api` will collide
    // with it. Use a subdomain unless you know that path space is free.
    //
    // Wire filenames (blyg.json, feed.xml, items/…) are fixed either way.
    "MOUNT": ""
  },

  // Check saved XML every minute; poll due subscriptions every 15 minutes.
  // Repair legacy imports and prune expired mentions daily at midnight UTC.
  // The feed-only tick skips subscription scans and housekeeping.
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *", "0 0 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      // FILL ME (2 of 4) — `npx wrangler d1 create blyg-yourname` prints both.
      "database_name": "blyg",
      // FILL ME — a deploy with this placeholder fails loudly, which is the
      // intent: it is better than a UUID-shaped value that deploys somewhere
      // unexpected. Local dev and the test suite use miniflare's own D1 and
      // never read it.
      "database_id": "FILL-ME-run-npm-run-init",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      // FILL ME (3 of 4) — `npx wrangler r2 bucket create blyg-yourname-media`.
      // Stores image attachments and the rendered feed cache. Feed objects use
      // an internal prefix and are served only by the feed handler.
      "bucket_name": "blyg-media"
    }
  ]

  // OPTIONAL — Cloudflare Workers AI, for the `@cf/…` models in Settings →
  // AI models (Gemma, Llama, Mistral). No API key: inference is billed to the
  // account this Worker runs on. Nothing uses it until you choose such a model.
  // To enable, add a comma after the "r2_buckets" block above and uncomment:
  //
  //   "ai": { "binding": "AI" }

  // FILL ME (4 of 4) — your account and your domain, neither of which has a
  // default worth guessing. `npm run init` writes them; by hand, add:
  //
  //   "account_id": "…",                         // wrangler whoami
  //   "routes": [
  //     { "pattern": "blyg.you.com", "custom_domain": true }
  //   ]
  //
  // A Custom Domain provisions its own DNS. Plain `routes` with `zone_name` do
  // not, and Cloudflare's trailing "/*" does not match the bare prefix, so a
  // path mount needs both "you.com/blyg" and "you.com/blyg/*" — one reason the
  // subdomain shape is recommended.
  //
  // ── Keep this file generic ───────────────────────────────────────────────
  // If you are contributing upstream rather than running your own blyg: do not
  // commit an account id, a database id, a bucket you own or a route here. Put
  // them in `wrangler.private.jsonc`, which is gitignored, and deploy with
  // `--config wrangler.private.jsonc`. This file is shipped to every person who
  // stands up a blyg, and it should tell them nothing about yours.
}
