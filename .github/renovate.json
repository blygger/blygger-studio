{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "automerge": false,
  "npmrc": "legacy-peer-deps=true\n",
  "docker-compose": {
    "managerFilePatterns": ["/^scripts\\/oauth-conformance\\.compose\\.yml$/"]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "The official OpenID images use release-v-prefixed version tags.",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["registry.gitlab.com/openid/conformance-suite", "registry.gitlab.com/openid/conformance-suite/nginx"],
      "versioning": "regex:^release-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": ["better-auth", "@better-auth/oauth-provider"],
      "groupName": "Better Auth",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["@modelcontextprotocol/client", "@modelcontextprotocol/server"],
      "groupName": "MCP SDK",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["@tanstack/db", "@tanstack/react-db", "@tanstack/query-db-collection"],
      "groupName": "TanStack DB",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["@cloudflare/vitest-plugin", "@cloudflare/workers-types", "miniflare", "wrangler"],
      "groupName": "Cloudflare tooling",
      "separateMajorMinor": false
    },
    {
      "description": "Follow the prerelease lines already used by this project.",
      "matchPackageNames": ["@tanstack/db", "@tanstack/react-db", "miniflare"],
      "ignoreUnstable": false,
      "respectLatest": false
    }
  ]
}
