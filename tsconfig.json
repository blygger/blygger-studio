{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "resolveJsonModule": true,
    // On since session 28. `threadEditPage` computed a `discardBtn` and never
    // rendered it, so the thread editor shipped with no way to discard a draft
    // or its unpublished changes — invisible to a suite that asserts on the
    // HTML that *is* emitted. An unused local is the cheapest signal that a
    // control was built and then dropped.
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"],
  "exclude": ["src/ui", "extensions/*/ui", "e2e"]
}
