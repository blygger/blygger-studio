.claude/settings.local.json
.env
.env.*
.DS_Store
node_modules/
.wrangler/
.dev.vars

# Deployment config for the blygs we actually run. Split out of the committed
# wrangler.jsonc in session 28 so the client ships as a generic artifact: a
# copy of this repo must carry no account, database, route or domain of ours.
# Every value in these is readable from the Cloudflare dashboard, so losing
# them costs nothing irreplaceable — but rebuilding by hand is how incident
# 2026-09-12-01 happened.
wrangler.private.jsonc
deploy-targets.json

# An operator's own edits to the model list (see models.json); merged at build.
models.local.json
# An operator's choice of Studio extensions to compile in (docs/extensions.md).
extensions.local.json
# Registry extensions vendored by `npm run ext:add` (docs/extension-registry.md):
# third-party source, pinned and hash-checked, recorded in extensions.local.json.
# Never committed, and never in a release build.
extensions-vendor/

# init's resume marker — records what has already been provisioned.
.blyg-init.json

# Rebuilt from the checked-in SDK and app source.
build/
sdk/dist/
playwright-report/
test-results/
sdk/LICENSE
